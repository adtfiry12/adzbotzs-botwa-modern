# ==============================================================================
# ADZBOTZS // ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- IDENTITAS BOT & OWNER ---
BOT_NAME=ADZBOTZS
OWNER_NAME=adtfiry
OWNER_NUMBER=628xxxxxxxxxx

# --- MODE KONEKSI WHATSAPP (DUAL MODE) ---
# 1. Mode Deploy / Hosting (Back4app):
#    Isi nomor WhatsApp bot di bawah (format: 628xxxxxx tanpa spasi/simbol).
#    Bot akan secara otomatis mencetak Kode Pairing (8 digit) pada log console.
# 2. Mode Terminal Lokal:
#    Kosongkan BOT_NUMBER. Bot akan otomatis menampilkan QR Code di terminal untuk di-scan.
BOT_NUMBER=

# --- WEB SERVER PORT ---
# Port untuk web server keep-alive (Back4app menyediakan variabel PORT otomatis).
PORT=8080

# --- GOOGLE GEMINI AI ---
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=isi_api_key_gemini_anda_di_sini
GEMINI_MODEL=gemini-flash-latest

# --- DATABASE MYSQL / TIDB CLOUD ---
# Mode Lokal:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=
#   DB_NAME=adzbotzs
#   DB_SSL=false
#
# Mode Cloud Deploy (TiDB Cloud):
#   DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_USER=username.root
#   DB_PASSWORD=password_tidb
#   DB_NAME=adzbotzs
#   DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adzbotzs
DB_SSL=false

# --- KUSTOMISASI TAMPILAN ---
# Path file logo untuk command .menu (opsional)
MENU_LOGO_PATH=assets/menu-logo.png
